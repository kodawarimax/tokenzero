#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
TokenZero Engine: Deterministic Agent Kernel
Entrypoint CLI for Claude Code, Codex, and Antigravity
"""

import sys
from pathlib import Path

# Add project root and local lib to sys.path for direct checkout execution
_ROOT = Path(__file__).resolve().parent.parent
_LIB = Path.home() / ".local" / "lib" / "tokenzero"
for p in [_ROOT, _LIB]:
    if p.exists() and str(p) not in sys.path:
        sys.path.insert(0, str(p))

try:
    from tokenzero.cli import main
except ImportError:
    from cli import main

if __name__ == "__main__":
    main()
